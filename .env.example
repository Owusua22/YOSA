# Resend (https://resend.com): create an API key in the YOSA-owned Resend account
RESEND_API_KEY=
# YOSA inbox(es) that receive enquiries, comma-separated
RESEND_TO=
# Sender. Use a verified YOSA domain, e.g. "YOSA Website <enquiries@yourdomain.org>".
# The default onboarding@resend.dev only delivers to the Resend account owner's own email (testing only).
RESEND_FROM=
# Public contact email shown on the site
NEXT_PUBLIC_ENQUIRY_EMAIL=info@youthopportunitiessouthafrica.org
# Approved donation route (https://...). Leave empty and Donate scrolls to the contact form.
NEXT_PUBLIC_DONATE_URL=
